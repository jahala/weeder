{
  "$schema": "schemas/garden.schema.json",
  "name": "weeder",
  "summary": "weeder reads what an agent produced and refuses dishonest growth, as SARIF, in milliseconds.",
  "kind": [
    "gate",
    "hook"
  ],
  "version": "0.1.0",
  "install": {
    "cargo": "weeder",
    "npm": "@plotplot/weeder",
    "binaries": {
      "x86_64-unknown-linux-musl": "https://github.com/jahala/weeder/releases/download/v0.1.0/weeder-x86_64-unknown-linux-musl.tar.gz",
      "aarch64-unknown-linux-musl": "https://github.com/jahala/weeder/releases/download/v0.1.0/weeder-aarch64-unknown-linux-musl.tar.gz",
      "x86_64-apple-darwin": "https://github.com/jahala/weeder/releases/download/v0.1.0/weeder-x86_64-apple-darwin.tar.gz",
      "aarch64-apple-darwin": "https://github.com/jahala/weeder/releases/download/v0.1.0/weeder-aarch64-apple-darwin.tar.gz",
      "x86_64-pc-windows-msvc": "https://github.com/jahala/weeder/releases/download/v0.1.0/weeder-x86_64-pc-windows-msvc.tar.gz"
    }
  },
  "faces": {
    "cli": "weeder",
    "skill": "SKILL.md",
    "hooks": {
      "claude": [
        "PreToolUse:Bash",
        "Stop"
      ],
      "gemini": [
        "BeforeTool:run_shell_command",
        "AfterAgent"
      ],
      "codex": [
        "PreToolUse",
        "Stop"
      ]
    },
    "git": [
      "pre-commit",
      "pre-push",
      "pre-rebase"
    ]
  },
  "check": "weeder check --format sarif",
  "metric": "bash scripts/check/calibration-bar.sh",
  "context": {
    "upfront_tokens": 0
  },
  "coverage": {
    "languages": [
      "go",
      "javascript",
      "python",
      "rust",
      "typescript"
    ],
    "kinds": [
      "config",
      "generated",
      "guardrail",
      "manifest",
      "prod",
      "test",
      "workflow"
    ]
  },
  "flagged": [
    {
      "what": "schemas/garden.schema.json",
      "why": "the vendored copy is the umbrella's contracts/manifest.schema.json at plotplot v1.3.0, and that contract moved twice in the week weeder was fitted to it. Re-fetch with scripts/umbrella-brand.sh and read the copy against the source before a release."
    }
  ]
}

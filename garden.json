{
  "$schema": "schemas/garden.schema.json",
  "name": "weeder",
  "summary": "weeder reads what an agent produced and refuses dishonest growth, as SARIF, in milliseconds.",
  "kind": [
    "gate",
    "hook"
  ],
  "version": "0.1.0",
  "install": {
    "npm": "npm install -g @plotplot/weeder",
    "cargo": "cargo install weeder",
    "binary": {
      "url": "https://github.com/jahala/weeder/releases/download/v{version}/{asset}",
      "targets": {
        "x86_64-unknown-linux-musl": "weeder-x86_64-unknown-linux-musl.tar.gz",
        "aarch64-unknown-linux-musl": "weeder-aarch64-unknown-linux-musl.tar.gz",
        "x86_64-apple-darwin": "weeder-x86_64-apple-darwin.tar.gz",
        "aarch64-apple-darwin": "weeder-aarch64-apple-darwin.tar.gz",
        "x86_64-pc-windows-msvc": "weeder-x86_64-pc-windows-msvc.zip"
      }
    }
  },
  "faces": [
    "check",
    "guard",
    "hook",
    "rules",
    "scan"
  ],
  "skill": "SKILL.md",
  "check": {
    "command": "weeder check --format sarif",
    "format": "sarif-2.1.0"
  },
  "metric": {
    "command": "bash scripts/check/calibration-bar.sh",
    "name": "block-level false-positive share across the calibration repositories"
  },
  "context_cost": 0,
  "flagged": [
    {
      "what": "schemas/garden.schema.json",
      "why": "the manifest schema belongs to the contracts repository, which does not exist yet. This copy is the proposal, and the shape may still move."
    }
  ]
}

target/
# A worker's scratch. Ignored again now that the nodes have run; pleach 0.0.1
# stages an ignored scratch file as a fatal error (dogfood P8), so a run under
# it takes this line out first.
.loop-scratch/
.context/

# The umbrella's own brand files arrive with a petals fetch and belong to the
# umbrella. weeder's product layer, .brand/products/weeder/, is weeder's and is
# committed — that is the path F6 verifies.
/.brand/*
!/.brand/products/
/.brand/products/*
!/.brand/products/weeder/
.DS_Store
.playwright-mcp/

# The dogfood notes and the questions are letters to the maintainers of tend2,
# pleach and umbel: their defect lists, their unreleased file paths, their
# version numbers, and this machine's layout. They keep being written here, at
# the paths AGENTS.md names; they are not weeder's record to publish.
/docs/dogfood.md
/docs/dogfood/
/docs/dogfood-report-*.md
/docs/questions-tend2-pleach-*.md

target/
# .loop-scratch/ is not ignored while pleach stages an ignored scratch file as
# a fatal error (dogfood P8); a landing strips whatever a worker left there.
.context/

# The umbrella's own brand files arrive with a petals fetch and belong to the
# umbrella. weed's product layer, .brand/products/weed/, is weed's and is
# committed — that is the path F6 verifies.
/.brand/*
!/.brand/products/
/.brand/products/*
!/.brand/products/weed/

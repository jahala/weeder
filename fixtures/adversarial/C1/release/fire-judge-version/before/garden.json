{
  "$schema": "schemas/garden.schema.json",
  "name": "sprout",
  "summary": "sprout reads a change and says what grew.",
  "kind": [
    "gate"
  ],
  "version": "0.4.0",
  "install": {
    "binaries": {
      "x86_64-unknown-linux-musl": "https://github.com/example/sprout/releases/download/v0.4.0/sprout-x86_64-unknown-linux-musl.tar.gz",
      "aarch64-apple-darwin": "https://github.com/example/sprout/releases/download/v0.4.0/sprout-aarch64-apple-darwin.tar.gz"
    }
  },
  "faces": {
    "cli": "sprout",
    "git": [
      "pre-commit"
    ]
  },
  "check": "sprout check --format sarif",
  "judges": [
    {
      "name": "weeder",
      "version": "0.4.0",
      "hooks": ["pre-commit", "commit-msg"]
    }
  ]
}
